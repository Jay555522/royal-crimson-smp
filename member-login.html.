
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Member Portal | Royal Crimson SMP</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
<h1>THE ROYAL CRIMSON SMP</h1>
<p>Member Portal</p>
</header>

<main>
<section class="card">
<h2>Member Login</h2>
<p>Welcome back to the Royal Crimson SMP!</p>

<form>
<label for="email">Email Address</label>
<input type="email" id="email" required>

<label for="password">Password</label>
<input type="password" id="password" required>

<button type="submit">Sign In</button>
</form>

<hr>

<h2>Create an Account</h2>
<p>New to the community? Create your member account.</p>

<form>
<label for="new-email">Email Address</label>
<input type="email" id="new-email" required>

<label for="new-password">Create Password</label>
<input type="password" id="new-password" required>

<button type="button">Sign Up</button>
</form>

<p><a href="index.html">Return to Homepage</a></p>
</section>
</main>

</body>
</html>
